#!/bin/sh
set -eu
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
project_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
if [ -x "$project_root/.venv/bin/python" ]; then
  setup_python="$project_root/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  setup_python=$(command -v python3)
else
  /usr/bin/osascript -e 'display alert "Нужен Python" message "Попросите устанавливающего агента подготовить Python 3.11 или новее. Вход в Telegram затем пройдёт в браузере."'
  exit 1
fi
if ! "$setup_python" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
  /usr/bin/osascript -e 'display alert "Нужен Python 3.11 или новее" message "Попросите устанавливающего агента проверить Python, затем откройте мастер снова."' || true
  exit 1
fi
(
  if ! "$setup_python" "$project_root/setup_web.py" --open >/dev/null 2>&1; then
    /usr/bin/osascript -e 'display alert "Мастер Telegram не открылся" message "Попросите устанавливающего агента проверить Python и браузер, затем запустите мастер снова. Сессия Telegram не удалялась."' || true
  fi
) &
