{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Telegram knowledge catalog",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_at",
    "sources",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "snapshot_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "kind",
        "public_url",
        "category",
        "area",
        "last_checked_at",
        "activity",
        "read_check",
        "coverage"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "telegram_peer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "channel",
            "group",
            "invite_community"
          ]
        },
        "public_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "telegram_invite_url": {
          "type": "string",
          "format": "uri"
        },
        "category": {
          "type": "string"
        },
        "area": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "members_observed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "last_post_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "activity": {
          "enum": [
            "active",
            "quiet",
            "stale",
            "unknown"
          ]
        },
        "read_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "method",
            "membership_requirement"
          ],
          "properties": {
            "status": {
              "enum": [
                "metadata_and_latest_message_read",
                "organizer_website_only",
                "anonymous_read_verified"
              ]
            },
            "method": {
              "enum": [
                "existing_telegram_mcp",
                "public_web"
              ]
            },
            "membership_requirement": {
              "type": "string"
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "full_history_downloaded",
            "raw_messages_published"
          ],
          "properties": {
            "full_history_downloaded": {
              "type": "boolean"
            },
            "raw_messages_published": {
              "const": false
            }
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "title",
        "date",
        "timezone",
        "start_time",
        "area",
        "venue",
        "address",
        "registration",
        "availability",
        "evidence",
        "status"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "type": "string"
        },
        "start_time": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "end_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "area": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "price_rub": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "price_conditions": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "registration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "contact_url",
            "method"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "contact_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "method": {
              "type": "string"
            }
          }
        },
        "availability": {
          "enum": [
            "not_confirmed_with_organizer",
            "confirmed_at_timestamp",
            "sold_out"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "posted_at",
              "checked_at"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "posted_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "status": {
          "enum": [
            "announced_for_exact_date",
            "cancelled",
            "completed"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string"
        },
        "game": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    }
  }
}
